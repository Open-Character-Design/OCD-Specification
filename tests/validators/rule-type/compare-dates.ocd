id: compare-dates
type: validationSpec
schemaVersion: 1
metadata:
  name: Date Comparison Validation
  description: Validates date comparisons and relationships.
policy:
  allowUnknownFields: true

definitions:
  enums: {}
  types: {}

rules:
  - path: "meta.versioning.last_modified"
    type: string
    format: date-time
    compare:
      greaterThan: "meta.versioning.created_at"
    message: "Last modified must be after created date"

