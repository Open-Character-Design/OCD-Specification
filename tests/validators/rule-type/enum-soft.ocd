id: enum-soft
type: validationSpec
schemaVersion: 1
metadata:
  name: Soft Enum Validation
  description: Allows enum violations as warnings.
policy:
  allowUnknownFields: true

definitions:
  enums:
    Status: ["active", "inactive", "pending"]
    Priority: ["low", "medium", "high"]

rules:
  - path: "status"
    enum: "@enums.Status"
    severity: warning
    message: "Status should be one of the allowed values"
  - path: "priority"
    enum: "@enums.Priority"
    severity: warning
    message: "Priority should be one of the allowed values"

