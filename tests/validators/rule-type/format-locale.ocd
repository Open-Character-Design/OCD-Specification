id: format-locale
type: validationSpec
schemaVersion: 1
metadata:
  name: Locale Format Validation
  description: Validates locale and language-code formats.
policy:
  allowUnknownFields: true

definitions:
  enums: {}
  types: {}

rules:
  - path: "meta.locale"
    type: string
    format: locale
    message: "Locale must be in valid format"
  - path: "meta.language"
    type: string
    format: language-code
    message: "Language code must be in valid format"

