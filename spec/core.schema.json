{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencharacter.dev/schema/core-1.0.json",
  "title": "Open Character Design Specification Core",
  "oneOf": [
    { "$ref": "#/$defs/CharacterDefinition" },
    { "$ref": "#/$defs/CharacterDefinitionLite" },
    { "$ref": "#/$defs/CharacterInstance" }
  ],
  "$defs": {
    "UUID": {
      "type": "string",
      "format": "uuid"
    },
    "Slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "LocalizedText": {
      "type": "object",
      "required": ["text", "lang"],
      "properties": {
        "text": { "type": "string" },
        "lang": { "type": "string", "minLength": 2 }
      },
      "additionalProperties": false
    },
    "Names": {
      "type": "object",
      "required": ["canon"],
      "properties": {
        "canon": { "type": "string", "minLength": 1 },
        "display": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/LocalizedText" }
            },
            {
              "type": "object",
              "patternProperties": {
                "^[a-z]{2}(?:-[A-Za-z0-9]+)*$": { "type": "string" }
              },
              "additionalProperties": false
            }
          ]
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "AgeMeasurement": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Identity": {
      "type": "object",
      "required": ["entity_kind", "sapience_level"],
      "properties": {
        "entity_kind": {
          "type": "string",
          "enum": [
            "person",
            "collective",
            "creature",
            "object",
            "place",
            "abstract",
            "ai"
          ]
        },
        "species": {
          "type": "string",
          "enum": [
            "human",
            "ai",
            "alien",
            "collective",
            "object",
            "deity",
            "other"
          ]
        },
        "sapience_level": {
          "type": "string",
          "enum": [
            "animal",
            "tool",
            "agent",
            "sapient",
            "transcendent"
          ]
        },
        "gender": {
          "type": "string",
          "description": "Gender identity and expression"
        },
        "pronouns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Preferred pronouns for the character"
        },
        "age": {
          "type": "object",
          "properties": {
            "nominal": { "$ref": "#/$defs/AgeMeasurement" },
            "biological": { "$ref": "#/$defs/AgeMeasurement" },
            "chronological": { "$ref": "#/$defs/AgeMeasurement" },
            "chrono_override": { "$ref": "#/$defs/AgeMeasurement" },
            "rationale": { "type": "string" }
          },
          "additionalProperties": false
        },
        "origins": {
          "type": "object",
          "properties": {
            "universe": { "type": "string" },
            "birthplace": { "type": "string" },
            "debut_date": { "type": "string", "format": "date" },
            "creation_context": { "type": "string" }
          },
          "additionalProperties": false
        },
        "continuity": {
          "type": "object",
          "properties": {
            "canon": {
              "type": "string",
              "enum": ["prime", "alt", "fanon", "apocrypha"]
            },
            "timeline_ids": {
              "type": "array",
              "items": { "$ref": "#/$defs/UUID" }
            }
          },
          "additionalProperties": false
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "protagonist",
              "antagonist",
              "support",
              "ensemble",
              "npc",
              "avatar"
            ]
          }
        },
        "composite_of": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "control_share", "exposure"],
            "properties": {
              "ref": { "$ref": "#/$defs/UUID" },
              "control_share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "exposure": {
                "type": "string",
                "enum": ["public", "secret"]
              },
              "visibility": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "secret_identities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["public_name", "exposure_risk"],
            "properties": {
              "public_name": { "type": "string" },
              "exposure_risk": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "Meta": {
      "type": "object",
      "required": ["versioning"],
      "properties": {
        "creators": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "rights": {
          "type": "object",
          "properties": {
            "owner": { "type": "string" },
            "license": { "type": "string" },
            "usage_notes": { "type": "string" }
          },
          "additionalProperties": true
        },
        "versioning": {
          "type": "object",
          "required": ["created_at", "last_modified"],
          "properties": {
            "created_at": { "type": "string", "format": "date-time" },
            "last_modified": { "type": "string", "format": "date-time" },
            "change_log": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        "external_ids": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "audit": {
          "type": "object",
          "properties": {
            "edited_by": { "type": "string" },
            "source_files": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        "character_content_profile": { "$ref": "#/$defs/CharacterContentProfile" }
      },
      "additionalProperties": true
    },
    "Stat": {
      "type": "object",
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string" },
        "value": { "type": ["number", "string", "object", "array", "boolean"] },
        "unit": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "temp": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "EffectTimer": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Appearance": {
      "type": "object",
      "properties": {
        "physical_description": { "type": "string" },
        "distinctive_features": {
          "type": "array",
          "items": { "type": "string" }
        },
        "clothing_style": { "type": "string" },
        "body_language": {
          "type": "array",
          "items": { "type": "string" }
        },
        "height": { "$ref": "#/$defs/AgeMeasurement" },
        "weight": { "$ref": "#/$defs/AgeMeasurement" },
        "eye_color": { "type": "string" },
        "hair_color": { "type": "string" },
        "skin_tone": { "type": "string" }
      },
      "additionalProperties": true
    },
    "PsychologicalProfile": {
      "type": "object",
      "properties": {
        "personality_traits": {
          "type": "array",
          "items": { "type": "string" }
        },
        "motivations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fears": {
          "type": "array",
          "items": { "type": "string" }
        },
        "values": {
          "type": "array",
          "items": { "type": "string" }
        },
        "beliefs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "summary": { "type": "string" },
        "traits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kind"],
            "properties": {
              "name": { "type": "string" },
              "kind": {
                "type": "string",
                "enum": ["bipolar", "scalar", "flag"]
              },
              "value": { "type": ["number", "boolean"] },
              "polarity": { "type": "number", "minimum": -1, "maximum": 1 },
              "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
              "unit": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "AbilitiesAndSkills": {
      "type": "object",
      "properties": {
        "strengths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "weaknesses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "special_abilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "powers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "vulnerabilities": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "CommunicationStyle": {
      "type": "object",
      "properties": {
        "speech_patterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "vocabulary": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tone": {
          "type": "array",
          "items": { "type": "string" }
        },
        "communication_preferences": {
          "type": "array",
          "items": { "type": "string" }
        },
        "catchphrases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "speech_quirks": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "Background": {
      "type": "object",
      "properties": {
        "origin": { "type": "string" },
        "birthplace": { "type": "string" },
        "family": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "relationship": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "education": {
          "type": "array",
          "items": { "type": "string" }
        },
        "significant_events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event": { "type": "string" },
              "date": { "type": "string" },
              "impact": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "character_ref": { "$ref": "#/$defs/UUID" },
              "relationship_type": { "type": "string" },
              "description": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "affiliations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "milestones": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "AIAgentProfile": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "use_cases": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["text_chat", "voice_assistant", "avatar_video", "multi_agent"]
          }
        },
        "system_prompt": { "type": "string" },
        "persona": { "$ref": "#/$defs/AIPersona" },
        "tone_and_style": { "$ref": "#/$defs/AIToneAndStyle" },
        "communication_mediums": { "$ref": "#/$defs/AICommunicationMediums" },
        "memory": { "$ref": "#/$defs/AIMemoryConfiguration" },
        "safety_and_alignment": { "$ref": "#/$defs/AISafetyAndAlignment" },
        "orchestration": { "$ref": "#/$defs/AIOrchestration" }
      },
      "additionalProperties": true
    },
    "AIPersona": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "domain_expertise": {
          "type": "array",
          "items": { "type": "string" }
        },
        "traits": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "AIToneAndStyle": {
      "type": "object",
      "properties": {
        "tone": { "type": "string" },
        "formality": {
          "type": "string",
          "enum": ["casual", "moderate", "formal", "academic"]
        },
        "vocabulary_level": {
          "type": "string",
          "enum": ["simple", "general_public", "technical", "expert"]
        },
        "verbosity": {
          "type": "string",
          "enum": ["concise", "short", "moderate", "detailed"]
        },
        "formatting": {
          "type": "object",
          "properties": {
            "allow_markdown": { "type": "boolean" },
            "allow_emojis": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "AICommunicationMediums": {
      "type": "object",
      "properties": {
        "text_chat": {
          "type": "object",
          "properties": {
            "instructions": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        "voice_assistant": {
          "type": "object",
          "properties": {
            "instructions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "ssml_enabled": { "type": "boolean" },
            "preferred_voice": { "type": "string" }
          },
          "additionalProperties": true
        },
        "avatar_video": {
          "type": "object",
          "properties": {
            "instructions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "visual_emotion_tags": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "AIMemoryConfiguration": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["none", "short_term", "long_term", "hybrid"]
        },
        "short_term": {
          "type": "object",
          "properties": {
            "context_window": { "type": "string" },
            "summarization_strategy": { "type": "string" }
          },
          "additionalProperties": true
        },
        "long_term": {
          "type": "object",
          "properties": {
            "vector_db": { "type": "boolean" },
            "memory_scope": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        "personalization": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "profile_keys": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "AISafetyAndAlignment": {
      "type": "object",
      "properties": {
        "refusal_behavior": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": ["polite_redirection", "direct_refusal", "topic_change"]
            },
            "template": { "type": "string" }
          },
          "additionalProperties": true
        },
        "disallowed_topics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "model_alignment": { "type": "string" },
        "external_filters": {
          "type": "object",
          "properties": {
            "input_filtering": { "type": "boolean" },
            "output_moderation": { "type": "boolean" },
            "categories": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "AIOrchestration": {
      "type": "object",
      "properties": {
        "multi_agent_support": { "type": "boolean" },
        "agent_role": { "type": "string" },
        "team_context": { "type": "string" },
        "interaction_protocol": {
          "type": "object",
          "properties": {
            "speak_when_addressed": { "type": "boolean" },
            "context_sharing": { "type": "boolean" },
            "shared_memory_scope": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        "coordinator": {
          "type": "object",
          "properties": {
            "agent_id": { "type": "string" },
            "function": { "type": "string" }
          },
          "additionalProperties": true
        },
        "tool_access": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "trigger_condition": { "type": "string" },
              "method": { "type": "string" },
              "output_handling": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "CharacterDefinition": {
      "type": "object",
      "required": [
        "kind",
        "ocd_version",
        "id",
        "slug",
        "names",
        "identity",
        "meta"
      ],
      "properties": {
        "kind": { "const": "CharacterDefinition" },
        "ocd_version": { "type": "string" },
        "$schema": { "type": "string", "format": "uri" },
        "$id": { "type": "string", "format": "uri" },
        "id": { "$ref": "#/$defs/UUID" },
        "slug": { "$ref": "#/$defs/Slug" },
        "names": { "$ref": "#/$defs/Names" },
        "identity": { "$ref": "#/$defs/Identity" },
        "appearance": { "$ref": "#/$defs/Appearance" },
        "metaphysics": { "$ref": "#/$defs/AbilitiesAndSkills" },
        "personality": { "$ref": "#/$defs/PsychologicalProfile" },
        "background": { "$ref": "#/$defs/Background" },
        "communication": { "$ref": "#/$defs/CommunicationStyle" },
        "behavior": { "type": "object", "additionalProperties": true },
        "media_profiles": { "type": "object", "additionalProperties": true },
        "ai_agent": { "$ref": "#/$defs/AIAgentProfile" },
        "meta": { "$ref": "#/$defs/Meta" },
        "licensing_profile": { "$ref": "#/$defs/LicensingProfile" },
        "extras": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "CharacterDefinitionLite": {
      "type": "object",
      "required": [
        "name",
        "type",
        "summary"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "person",
            "collective",
            "creature",
            "object",
            "place",
            "abstract",
            "ai"
          ]
        },
        "summary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "CharacterInstance": {
      "type": "object",
      "required": [
        "kind",
        "ocd_version",
        "instance_id",
        "from_def",
        "state"
      ],
      "properties": {
        "kind": { "const": "CharacterInstance" },
        "ocd_version": { "type": "string" },
        "$schema": { "type": "string", "format": "uri" },
        "$id": { "type": "string", "format": "uri" },
        "instance_id": { "$ref": "#/$defs/UUID" },
        "from_def": { "$ref": "#/$defs/UUID" },
        "state": {
          "type": "object",
          "properties": {
            "stats": {
              "type": "array",
              "items": { "$ref": "#/$defs/Stat" }
            },
            "location_ref": { "$ref": "#/$defs/UUID" },
            "active_effects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "effect": { "type": "string" },
                  "remaining": { "$ref": "#/$defs/EffectTimer" },
                  "source_ref": { "$ref": "#/$defs/UUID" }
                },
                "required": ["effect"],
                "additionalProperties": true
              }
            },
            "cooldowns": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["ability_ref", "remaining"],
                "properties": {
                  "ability_ref": { "$ref": "#/$defs/UUID" },
                  "remaining": { "$ref": "#/$defs/EffectTimer" }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "progression": { "type": "object", "additionalProperties": true },
        "session": { "type": "object", "additionalProperties": true },
        "extras": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "CharacterContentProfile": {
      "type": "object",
      "properties": {
        "target_audience": {
          "type": "object",
          "properties": {
            "age_range": { "type": "string" },
            "demographics": { "type": "string" },
            "tone_alignment": { "type": "string" }
          },
          "additionalProperties": true
        },
        "appropriateness": {
          "type": "object",
          "properties": {
            "violence_level": {
              "type": "string",
              "enum": ["none", "cartoon", "realistic", "extreme"]
            },
            "sexuality_level": {
              "type": "string",
              "enum": ["none", "implied", "explicit"]
            },
            "language_level": {
              "type": "string",
              "enum": ["clean", "mild", "strong", "explicit"]
            },
            "cultural_sensitivity": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        "content_rating": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["system", "rating"],
            "properties": {
              "system": {
                "type": "string",
                "enum": ["ESRB", "PEGI", "IARC", "MPA", "CERO", "USK", "ACB"]
              },
              "rating": { "type": "string" },
              "notes": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "deployment_contexts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "safety_warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "License": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "spdx_id": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "jurisdiction": { "type": "string" },
        "territory_exceptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "term": {
          "type": "object",
          "properties": {
            "start": { "type": "string", "format": "date" },
            "end": { "type": ["string", "null"], "format": "date" },
            "revocable": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "permissions": {
          "type": "object",
          "properties": {
            "reuse": { "type": "boolean" },
            "remix": { "type": "boolean" },
            "commercial_use": { "type": "boolean" },
            "redistribution": { "type": "boolean" },
            "private_use": { "type": "boolean" },
            "sublicense": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "restrictions": {
          "type": "object",
          "properties": {
            "attribution_required": { "type": "boolean" },
            "share_alike": { "type": "boolean" },
            "non_commercial": { "type": "boolean" },
            "no_derivatives": { "type": "boolean" },
            "trademark_restrictions": { "type": "boolean" },
            "personality_rights_reserved": { "type": "boolean" },
            "territory_limited": { "type": "boolean" },
            "embargoed_uses": {
              "type": "array",
              "items": { "type": "string" }
            },
            "other_prohibitions": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        "attribution": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "text_template": { "type": "string" },
            "fields_required": {
              "type": "array",
              "items": { "type": "string" }
            },
            "placement_guidelines": { "type": "string" }
          },
          "additionalProperties": true
        },
        "ownership": {
          "type": "object",
          "properties": {
            "rights_holder": { "type": "string" },
            "authors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "role": { "type": "string" },
                  "contact": { "type": "string" }
                },
                "additionalProperties": true
              }
            },
            "publisher": { "type": "string" },
            "contact_for_rights": { "type": "string" }
          },
          "additionalProperties": true
        },
        "provenance": {
          "type": "object",
          "properties": {
            "source_repository": { "type": "string", "format": "uri" },
            "asset_registry_ids": {
              "type": "array",
              "items": { "type": "string" }
            },
            "created": { "type": "string", "format": "date-time" },
            "last_modified": { "type": "string", "format": "date-time" },
            "checksum_manifest": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "InheritancePolicy": {
      "type": "object",
      "properties": {
        "precedence": {
          "type": "string",
          "enum": ["asset_overrides_default", "default_overrides_asset", "merge_most_restrictive"]
        },
        "conflict_resolution": {
          "type": "string",
          "enum": ["most_restrictive_wins", "least_restrictive_wins", "explicit_wins"]
        },
        "implicit_inheritance": { "type": "boolean" },
        "require_explicit_for_weaken": { "type": "boolean" },
        "explicit_waivers_and_grants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "asset_id": { "type": "string" },
              "waiver_type": { "type": "string" },
              "granted_by": { "type": "string" },
              "date": { "type": "string", "format": "date" },
              "notes": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "PlatformOverrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "license_file_path": { "type": "string" },
          "spdx_id": { "type": "string" },
          "license_category": { "type": "string" },
          "attribution_url": { "type": "string", "format": "uri" },
          "model_card_license": { "type": "string" },
          "allow_commercial_derivatives": { "type": "boolean" },
          "seat_type": { "type": "string" },
          "redistribution": { "type": "boolean" },
          "downloadable": { "type": "boolean" },
          "license_tag": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "CharacterConcept": {
      "type": "object",
      "properties": {
        "inherits_default": { "type": "boolean" },
        "license": { "$ref": "#/$defs/License" },
        "coverage": {
          "type": "object",
          "properties": {
            "includes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "excludes": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "ThirdPartyComponent": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" },
        "license": { "$ref": "#/$defs/License" },
        "attribution_override": { "type": "string" }
      },
      "additionalProperties": true
    },
    "AssetLicense": {
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "inherits_default": { "type": "boolean" },
        "license": { "$ref": "#/$defs/License" },
        "third_party_components": {
          "type": "array",
          "items": { "$ref": "#/$defs/ThirdPartyComponent" }
        }
      },
      "additionalProperties": true
    },
    "NonCopyrightRights": {
      "type": "object",
      "properties": {
        "trademarks": {
          "type": "object",
          "properties": {
            "claimed": { "type": "boolean" },
            "marks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "type": {
                    "type": "string",
                    "enum": ["word_mark", "logo_mark", "design_mark", "service_mark"]
                  },
                  "owner": { "type": "string" }
                },
                "additionalProperties": true
              }
            },
            "usage_guidelines_url": { "type": "string", "format": "uri" }
          },
          "additionalProperties": true
        },
        "personality_rights": {
          "type": "object",
          "properties": {
            "likeness_protected": { "type": "boolean" },
            "contact_for_clearance": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "Distribution": {
      "type": "object",
      "properties": {
        "allowed_channels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbidden_channels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "geo_blocks": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "Compliance": {
      "type": "object",
      "properties": {
        "acknowledgements_required": { "type": "boolean" },
        "attribution_bundle_file": { "type": "string" },
        "audit_trail": {
          "type": "object",
          "properties": {
            "license_history": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": { "type": "string", "format": "date" },
                  "change": { "type": "string" }
                },
                "additionalProperties": true
              }
            },
            "grants_and_waivers": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "EffectivePolicy": {
      "type": "object",
      "properties": {
        "evaluation_mode": {
          "type": "string",
          "enum": ["most_restrictive_wins", "least_restrictive_wins", "explicit_wins"]
        },
        "computed_on_save": { "type": "boolean" },
        "output_fields": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "LicensingProfile": {
      "type": "object",
      "required": ["schema_version", "character", "default_license", "inheritance_policy"],
      "properties": {
        "schema_version": { "type": "string" },
        "character": {
          "type": "object",
          "required": ["id", "display_name", "version"],
          "properties": {
            "id": { "type": "string" },
            "display_name": { "type": "string" },
            "version": { "type": "string" }
          },
          "additionalProperties": true
        },
        "default_license": { "$ref": "#/$defs/License" },
        "inheritance_policy": { "$ref": "#/$defs/InheritancePolicy" },
        "platform_overrides": { "$ref": "#/$defs/PlatformOverrides" },
        "character_concept": { "$ref": "#/$defs/CharacterConcept" },
        "assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/AssetLicense" }
        },
        "non_copyright_rights": { "$ref": "#/$defs/NonCopyrightRights" },
        "distribution": { "$ref": "#/$defs/Distribution" },
        "compliance": { "$ref": "#/$defs/Compliance" },
        "effective_policy": { "$ref": "#/$defs/EffectivePolicy" }
      },
      "additionalProperties": true
    }
  }
}
