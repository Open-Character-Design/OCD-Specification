id: type-flexible
type: validationSpec
schemaVersion: 1
metadata:
  name: Flexible Type Validation
  description: Allows flexible type coercion.
policy:
  allowUnknownFields: true

definitions:
  enums: {}
  types: {}

rules:
  - path: "age"
    type: number
    message: "Age must be numeric"
  - path: "metadata"
    type: object
    message: "Metadata must be an object"

