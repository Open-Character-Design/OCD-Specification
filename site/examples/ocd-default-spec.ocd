id: ocd-default-spec
type: validationSpec
metadata:
  name: Default OCD Specification
  description: Baseline validation and schema for OCD characters
  version: "1.0.0"
  created_at: "2024-01-01T00:00:00Z"
  last_modified: "2024-01-01T00:00:00Z"

validation:
  mode: relaxed
  constraints:
    allowUnknownFields: true
    softEnums: true
    strictTypes: false
    enforceRequired: true
    validateReferences: false

  rules:
    # Basic structure validation
    structure:
      required:
        - ocd_version
        - id
        - names
        - identity
      optional:
        - kind
        - slug
        - personality
        - appearance
        - background
        - relationships
        - meta
        - extensions

    # Type validation (relaxed)
    types:
      ocd_version: string
      id: string
      names:
        type: object
        required: [canon]
        properties:
          canon: string
          display: [string, array, object]
          aliases: array
      identity:
        type: object
        required: [entity_kind, sapience_level]
        properties:
          entity_kind: string
          species: string
          sapience_level: string
          pronouns: array
          age: [string, object]
          physical_description: string
      personality:
        type: object
        properties:
          summary: string
          traits: array
          quirks: array
          motivations: array
      appearance:
        type: object
        properties:
          physical: object
          clothing: object
          accessories: array
      background:
        type: object
        properties:
          history: string
          culture: string
          education: string
          occupation: string
      relationships:
        type: array
        items:
          type: object
          properties:
            character_id: string
            relationship_type: string
            description: string
      meta:
        type: object
        properties:
          tags: array
          genres: array
          media: array
          content_rating: string
          versioning: object
      extensions:
        type: object
        additionalProperties: true

    # Enum validation (soft - warnings only in relaxed mode)
    enums:
      entity_kind:
        values: [person, collective, creature, object, place, abstract, ai]
        strict: false
      species:
        values: [human, ai, alien, collective, object, deity, other]
        strict: false
      sapience_level:
        values: [animal, tool, agent, sapient, transcendent]
        strict: false

    # Trait validation
    traits:
      types: [bipolar, scalar, flag]
      bipolar:
        required: [name, kind, value]
        optional: [axis, description]
        axis_normalization: true
      scalar:
        required: [name, kind, value]
        optional: [min, max, unit, description]
      flag:
        required: [name, kind, value]
        optional: [description]

    # Normalization rules
    normalization:
      slugs:
        pattern: "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        case: lower
        deduplicate: true
      tags:
        case: lower
        deduplicate: true
      trait_axes:
        canonical: "↔"
        alternatives: ["-", "_", "↔"]
        normalize: true

    # Warning rules
    warnings:
      - code: MISSING_CANON_NAME
        condition: "!names.canon"
        message: "Missing canonical name"
      - code: NONCANONICAL_CANON_NAME
        condition: "names.canon && !/^[A-Z]/.test(names.canon)"
        message: "Canonical name should be properly capitalized"
      - code: NORMALIZED_SLUG
        condition: "slug && slug !== normalized_slug"
        message: "Slug was normalized"
      - code: NORMALIZED_AXIS
        condition: "trait.axis && trait.axis !== normalized_axis"
        message: "Trait axis was normalized"

  # Extension points for custom validation
  extensions:
    custom_rules: []
    custom_enums: {}
    custom_types: {}
    custom_warnings: []
