id: ocd-default-spec
type: validationSpec
schemaVersion: 1
metadata:
  name: Default OCD Specification
  description: Baseline validation and schema for OCD characters
  version: "1.0.0"

policy:
  allowUnknownFields: true
  unknownFieldSeverity: warning

definitions:
  enums:
    EntityKind: ["person", "collective", "creature", "object", "place", "abstract", "ai"]
    Species: ["human", "ai", "alien", "collective", "object", "deity", "other"]
    SapienceLevel: ["animal", "tool", "agent", "sapient", "transcendent"]
    TraitKind: ["bipolar", "scalar", "flag"]
    AIUseCases: ["text_chat", "voice_assistant", "avatar_video", "multi_agent"]
    AIFormality: ["casual", "moderate", "formal", "academic"]
    AIVocabularyLevel: ["simple", "general_public", "technical", "expert"]
    AIVerbosity: ["concise", "short", "moderate", "detailed"]
    AIMemoryType: ["none", "short_term", "long_term", "hybrid"]
    AIRefusalMethod: ["polite_redirection", "direct_refusal", "topic_change"]

rules:
  # Basic structure validation
  - path: "ocd_version"
    presence: required
    type: string
    minLength: 1

  - path: "id"
    presence: required
    type: string
    minLength: 1

  - path: "names"
    presence: required
    type: object

  - path: "names.canon"
    presence: required
    type: string
    minLength: 1

  - path: "names.display"
    type: string

  - path: "names.aliases"
    type: array
    items:
      type: string

  - path: "identity"
    presence: required
    type: object

  - path: "identity.entity_kind"
    presence: required
    type: string
    enum: "@enums.EntityKind"

  - path: "identity.species"
    type: string
    enum: "@enums.Species"

  - path: "identity.sapience_level"
    presence: required
    type: string
    enum: "@enums.SapienceLevel"

  - path: "identity.pronouns"
    type: array
    items:
      type: string

  - path: "identity.age"
    type: string

  - path: "identity.physical_description"
    type: string

  - path: "personality"
    type: object

  - path: "personality.summary"
    type: string

  - path: "personality.traits"
    type: array
    items:
      type: object

  - path: "personality.traits[].name"
    type: string

  - path: "personality.traits[].kind"
    type: string
    enum: "@enums.TraitKind"

  - path: "personality.traits[].value"
    type: ["number", "boolean"]

  # Core Fields Validation - Based on Research Findings
  # Identity Fields
  - path: "identity.gender"
    type: string
    description: "Gender identity and expression"

  # Physical Characteristics  
  - path: "appearance"
    type: object
    description: "Physical characteristics and appearance"

  - path: "appearance.physical_description"
    type: string
    description: "Visual description of physical features"

  - path: "appearance.distinctive_features"
    type: array
    items:
      type: string
    description: "Unique physical characteristics"

  - path: "appearance.clothing_style"
    type: string
    description: "Typical attire and fashion preferences"

  - path: "appearance.body_language"
    type: array
    items:
      type: string
    description: "Characteristic postures and gestures"

  # Psychological Profile
  - path: "personality.personality_traits"
    type: array
    items:
      type: string
    description: "Core personality characteristics"

  - path: "personality.motivations"
    type: array
    items:
      type: string
    description: "Primary drives and goals"

  - path: "personality.fears"
    type: array
    items:
      type: string
    description: "Core anxieties and vulnerabilities"

  - path: "personality.values"
    type: array
    items:
      type: string
    description: "Moral and ethical principles"

  - path: "personality.beliefs"
    type: array
    items:
      type: string
    description: "Philosophical or religious convictions"

  # Abilities and Skills
  - path: "metaphysics"
    type: object
    description: "Abilities, skills, and special capabilities"

  - path: "metaphysics.strengths"
    type: array
    items:
      type: string
    description: "Areas of expertise and natural talents"

  - path: "metaphysics.weaknesses"
    type: array
    items:
      type: string
    description: "Areas of limitation or vulnerability"

  - path: "metaphysics.special_abilities"
    type: array
    items:
      type: string
    description: "Unique powers or capabilities"

  - path: "metaphysics.skills"
    type: array
    items:
      type: string
    description: "Learned abilities and competencies"

  # Communication Style
  - path: "communication"
    type: object
    description: "Communication patterns and speech style"

  - path: "communication.speech_patterns"
    type: array
    items:
      type: string
    description: "Characteristic ways of speaking"

  - path: "communication.vocabulary"
    type: array
    items:
      type: string
    description: "Typical word choices and language use"

  - path: "communication.tone"
    type: array
    items:
      type: string
    description: "Emotional expression patterns"

  - path: "communication.communication_preferences"
    type: array
    items:
      type: string
    description: "Preferred methods of interaction"

  # Background and History
  - path: "background.origin"
    type: string
    description: "Place and circumstances of birth/creation"

  - path: "background.family"
    type: array
    items:
      type: object
    description: "Family relationships and dynamics"

  - path: "background.education"
    type: array
    items:
      type: string
    description: "Learning background and skills"

  - path: "background.significant_events"
    type: array
    items:
      type: object
    description: "Key life experiences that shaped the character"

  - path: "background.relationships"
    type: array
    items:
      type: object
    description: "Important connections with other characters"

  - path: "personality.quirks"
    type: array
    items:
      type: string

  - path: "personality.motivations"
    type: array
    items:
      type: string

  - path: "appearance"
    type: object

  - path: "appearance.physical"
    type: object

  - path: "appearance.clothing"
    type: object

  - path: "appearance.accessories"
    type: array
    items:
      type: string

  - path: "background"
    type: object

  - path: "background.history"
    type: string

  - path: "background.culture"
    type: string

  - path: "background.education"
    type: string

  - path: "background.occupation"
    type: string

  - path: "relationships"
    type: array
    items:
      type: object

  - path: "relationships[].character_id"
    type: string

  - path: "relationships[].relationship_type"
    type: string

  - path: "relationships[].description"
    type: string

  - path: "meta"
    type: object

  - path: "meta.tags"
    type: array
    items:
      type: string
    maxLength: 32

  - path: "meta.genres"
    type: array
    items:
      type: string

  - path: "meta.media"
    type: array
    items:
      type: string

  - path: "meta.content_rating"
    type: string

  - path: "meta.versioning"
    type: object

  - path: "extensions"
    type: object

  # AI Agent Configuration Validation
  # All AI agent fields are optional, but if present must be properly structured
  - path: "ai_agent"
    type: object
    presence: optional

  - path: "ai_agent.id"
    type: string
    minLength: 1
    presence: optional

  - path: "ai_agent.role"
    type: string
    minLength: 1
    presence: optional

  - path: "ai_agent.use_cases"
    type: array
    items:
      type: string
      enum: "@enums.AIUseCases"
    presence: optional

  - path: "ai_agent.system_prompt"
    type: string
    presence: optional

  - path: "ai_agent.persona"
    type: object
    presence: optional

  - path: "ai_agent.persona.name"
    type: string
    minLength: 1
    presence: optional

  - path: "ai_agent.persona.description"
    type: string
    presence: optional

  - path: "ai_agent.persona.domain_expertise"
    type: array
    items:
      type: string
    presence: optional

  - path: "ai_agent.persona.traits"
    type: array
    items:
      type: string
    presence: optional

  - path: "ai_agent.tone_and_style"
    type: object
    presence: optional

  - path: "ai_agent.tone_and_style.tone"
    type: string
    presence: optional

  - path: "ai_agent.tone_and_style.formality"
    type: string
    enum: "@enums.AIFormality"
    presence: optional

  - path: "ai_agent.tone_and_style.vocabulary_level"
    type: string
    enum: "@enums.AIVocabularyLevel"
    presence: optional

  - path: "ai_agent.tone_and_style.verbosity"
    type: string
    enum: "@enums.AIVerbosity"
    presence: optional

  - path: "ai_agent.tone_and_style.formatting"
    type: object
    presence: optional

  - path: "ai_agent.tone_and_style.formatting.allow_markdown"
    type: boolean
    presence: optional

  - path: "ai_agent.tone_and_style.formatting.allow_emojis"
    type: boolean
    presence: optional

  - path: "ai_agent.communication_mediums"
    type: object
    presence: optional

  - path: "ai_agent.communication_mediums.text_chat"
    type: object
    presence: optional

  - path: "ai_agent.communication_mediums.text_chat.instructions"
    type: array
    items:
      type: string
    presence: optional

  - path: "ai_agent.communication_mediums.voice_assistant"
    type: object
    presence: optional

  - path: "ai_agent.communication_mediums.voice_assistant.instructions"
    type: array
    items:
      type: string
    presence: optional

  - path: "ai_agent.communication_mediums.voice_assistant.ssml_enabled"
    type: boolean
    presence: optional

  - path: "ai_agent.communication_mediums.voice_assistant.preferred_voice"
    type: string
    presence: optional

  - path: "ai_agent.communication_mediums.avatar_video"
    type: object
    presence: optional

  - path: "ai_agent.communication_mediums.avatar_video.instructions"
    type: array
    items:
      type: string
    presence: optional

  - path: "ai_agent.communication_mediums.avatar_video.visual_emotion_tags"
    type: boolean
    presence: optional

  - path: "ai_agent.memory"
    type: object
    presence: optional

  - path: "ai_agent.memory.type"
    type: string
    enum: "@enums.AIMemoryType"
    presence: optional

  - path: "ai_agent.memory.short_term"
    type: object
    presence: optional

  - path: "ai_agent.memory.short_term.context_window"
    type: string
    presence: optional

  - path: "ai_agent.memory.short_term.summarization_strategy"
    type: string
    presence: optional

  - path: "ai_agent.memory.long_term"
    type: object
    presence: optional

  - path: "ai_agent.memory.long_term.vector_db"
    type: boolean
    presence: optional

  - path: "ai_agent.memory.long_term.memory_scope"
    type: array
    items:
      type: string
    presence: optional

  - path: "ai_agent.memory.personalization"
    type: object
    presence: optional

  - path: "ai_agent.memory.personalization.enabled"
    type: boolean
    presence: optional

  - path: "ai_agent.memory.personalization.profile_keys"
    type: array
    items:
      type: string
    presence: optional

  - path: "ai_agent.safety_and_alignment"
    type: object
    presence: optional

  - path: "ai_agent.safety_and_alignment.refusal_behavior"
    type: object
    presence: optional

  - path: "ai_agent.safety_and_alignment.refusal_behavior.method"
    type: string
    enum: "@enums.AIRefusalMethod"
    presence: optional

  - path: "ai_agent.safety_and_alignment.refusal_behavior.template"
    type: string
    presence: optional

  - path: "ai_agent.safety_and_alignment.disallowed_topics"
    type: array
    items:
      type: string
    presence: optional

  - path: "ai_agent.safety_and_alignment.model_alignment"
    type: string
    presence: optional

  - path: "ai_agent.safety_and_alignment.external_filters"
    type: object
    presence: optional

  - path: "ai_agent.safety_and_alignment.external_filters.input_filtering"
    type: boolean
    presence: optional

  - path: "ai_agent.safety_and_alignment.external_filters.output_moderation"
    type: boolean
    presence: optional

  - path: "ai_agent.safety_and_alignment.external_filters.categories"
    type: array
    items:
      type: string
    presence: optional

  - path: "ai_agent.orchestration"
    type: object
    presence: optional

  - path: "ai_agent.orchestration.multi_agent_support"
    type: boolean
    presence: optional

  - path: "ai_agent.orchestration.agent_role"
    type: string
    presence: optional

  - path: "ai_agent.orchestration.team_context"
    type: string
    presence: optional

  - path: "ai_agent.orchestration.interaction_protocol"
    type: object
    presence: optional

  - path: "ai_agent.orchestration.interaction_protocol.speak_when_addressed"
    type: boolean
    presence: optional

  - path: "ai_agent.orchestration.interaction_protocol.context_sharing"
    type: boolean
    presence: optional

  - path: "ai_agent.orchestration.interaction_protocol.shared_memory_scope"
    type: array
    items:
      type: string
    presence: optional

  - path: "ai_agent.orchestration.coordinator"
    type: object
    presence: optional

  - path: "ai_agent.orchestration.coordinator.agent_id"
    type: string
    presence: optional

  - path: "ai_agent.orchestration.coordinator.function"
    type: string
    presence: optional

  - path: "ai_agent.orchestration.tool_access"
    type: object
    presence: optional