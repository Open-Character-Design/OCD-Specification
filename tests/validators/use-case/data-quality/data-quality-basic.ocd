id: data-quality-basic
type: validationSpec
schemaVersion: 1
metadata:
  name: Basic Data Quality Checks
  description: Basic validation for data quality assurance.
policy:
  allowUnknownFields: true

definitions:
  enums: {}
  types: {}

rules:
  - path: "id"
    type: string
    minLength: 1
  - path: "profile.name"
    type: string
    minLength: 1

