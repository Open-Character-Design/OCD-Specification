id: arrays-min-items
type: validationSpec
schemaVersion: 1
metadata:
  name: Array Minimum Items Constraint
  description: Enforces minimum array size.
policy:
  allowUnknownFields: true

definitions:
  enums: {}
  types: {}

rules: []

constraints:
  arrays:
    minItems:
      - path: "tags"
        value: 1
      - path: "skills"
        value: 3

